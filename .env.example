NODE_ENV=development
PORT=5000
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=fintrack_app
DB_PASSWORD=replace_me
DB_NAME=fintrack
DB_CONNECTION_LIMIT=10
DB_SSL=false
JWT_SECRET=replace_with_at_least_32_random_characters
JWT_EXPIRES_IN=1h
FRONTEND_ORIGIN=http://localhost:3000
PASSWORD_RESET_URL=http://localhost:3000/reset-password
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=FinTrack <no-reply@example.com>
REMINDER_INTERVAL_MS=3600000
REMINDER_DAYS=3
# Enable only against a dedicated empty test database ending in _test.
POSTGRES_INTEGRATION_TESTS=false
